#!/bin/sh
# Generated by tools/build-ipk.py from this template; edit the template, not output.
# First-party IPK is pinned here; official CLI is verified independently by setup.
set -eu
export PATH="/opt/bin:/opt/sbin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"
VERSION=@VERSION@
IPK=@IPK@
IPK_SHA256=@SHA256@
[ "${1:-}" = --lab-only ] && [ "$#" -eq 1 ] || {
    echo 'Usage: install-online.sh --lab-only (experimental; installs disabled)' >&2; exit 2;
}
@PLATFORM@
tt_install_bootstrap_timeout
tt_install_platform ''
# Only bootstrap verification tools when missing; dependencies use configured Entware feeds.
if ! type sha256sum >/dev/null 2>&1 || ! type curl >/dev/null 2>&1 || ! type tar >/dev/null 2>&1; then
    opkg update
    opkg install coreutils-sha256sum curl ca-bundle tar
fi
umask 077
WORK="/opt/ttm-setup-online-$(date +%Y%m%d-%H%M%S)-$$"
mkdir -m 700 "$WORK"
printf '%s\n' trusttunnel-merlin-staging-v1 >"$WORK/.trusttunnel-owned"
printf 'Installing asuswrt-merlin-trusttunnel %s\n' "$VERSION"
curl --fail --location --proto '=https' --proto-redir '=https' --connect-timeout 20 --max-time 180 \
    "https://github.com/VitaliyYakob/asuswrt-merlin-trusttunnel/releases/download/v${VERSION}/${IPK}" -o "$WORK/$IPK"
[ "$(sha256sum "$WORK/$IPK" | awk '{print $1}')" = "$IPK_SHA256" ] || {
    echo 'IPK SHA-256 mismatch; package was not extracted or installed' >&2; exit 1;
}
# Extract ONLY the dependency helper from the now verified package; no remote eval.
tar -xOzf "$WORK/$IPK" ./data.tar.gz >"$WORK/data.tar.gz"
for helper in prepare-entware.sh router-platform.sh; do
    tar -xOzf "$WORK/data.tar.gz" "./opt/share/asuswrt-merlin-trusttunnel/tools/$helper" >"$WORK/$helper"
done
sh "$WORK/prepare-entware.sh" --lab-only
opkg install "$WORK/$IPK"
rm -f "$WORK/$IPK" "$WORK/data.tar.gz" "$WORK/prepare-entware.sh" "$WORK/router-platform.sh" "$WORK/.trusttunnel-owned"
rmdir "$WORK"
printf '%s\n' 'Installed with VPN disabled. Open VPN > TrustTunnel over HTTPS.'
