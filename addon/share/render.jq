# JSON quoted strings are emitted as TOML basic strings; controls are validated.
"# Generated by TrustTunnel Merlin; do not edit.\n" +
"loglevel = \"info\"\nvpn_mode = \"general\"\nkillswitch_enabled = true\nexclusions = []\n\n[endpoint]\n" +
"hostname = " + (.hostname|tojson) + "\n" +
"addresses = " + (.addresses|tojson) + "\n" +
"username = " + (.username|tojson) + "\n" +
"password = " + (.password|tojson) + "\n" +
"has_ipv6 = false\nskip_verification = false\n" +
"certificate = " + (.certificate|tojson) + "\n" +
"upstream_protocol = " + (.protocol|tojson) + "\n" +
"anti_dpi = " + (.anti_dpi|tojson) + "\n" +
"dns_upstreams = " + (.dns_upstreams|tojson) + "\n\n" +
"[listener.tun]\ndevice_name = \"tt0\"\nuse_existing = false\nincluded_routes = []\nexcluded_routes = []\nchange_system_dns = false\n" +
"bound_if = " + (.wan_if|tojson) + "\n" +
"mtu_size = " + (.mtu|tostring) + "\n"
